---
// CTFTime results: one dense list per year, grouped like /team.
import { PS1 } from "../components/shell/PS1";
import Layout from "../layouts/Layout.astro";
import { META } from "../data/site";
import { ALL_RESULTS, FETCHED, SEASONS, TEAM_URL, eventUrl } from "../data/contests";
---

<Layout title={`Contests - ${META.title}`} description="L3ak's CTF results, from CTFTime.">
  <article class="doc">
    <header class="cmd">
      <h1>
        <span class="ps" aria-hidden="true"><PS1 /></span>{" "}cd <span class="cwd">contests</span>
      </h1>
      <p class="sub">
        // {ALL_RESULTS.length} results via <a href={TEAM_URL}>ctftime</a>, as of {FETCHED}
      </p>
    </header>

    {
      SEASONS.map((s) => (
        <section class="group" aria-labelledby={`y-${s.year}`}>
          <h2 id={`y-${s.year}`}>
            <span class="hash">#</span> {s.year}
            <span class="count">({s.results.length})</span>
            {s.rank && (
              <span class="season">
                rank {s.rank} · {s.points?.toFixed(3)} pts
              </span>
            )}
          </h2>
          <ol class="results">
            {s.results.map((r) => (
              <li class:list={["result", { podium: r.place <= 3 }]}>
                <span class="place">{r.place}</span>
                <a class="event" href={eventUrl(r.eventId)}>
                  {r.name}
                </a>
                <span class="rating">{r.rating.toFixed(3)}</span>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </article>
</Layout>

<style>
  .cmd h1 {
    font-size: inherit;
    font-weight: 400;
    margin: 0 0 6px;
  }

  .cwd {
    color: var(--accent);
  }

  .sub {
    color: var(--dim);
    font-size: 13px;
    margin: 0;
  }

  .sub a:hover {
    color: var(--accent);
  }

  .group {
    margin-top: 34px;
  }

  h2 {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .hash,
  .count {
    color: var(--dim);
  }

  .season {
    margin-left: auto;
    color: var(--dim);
    font-weight: 400;
  }

  .results {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .result {
    display: grid;
    grid-template-columns: 4ch minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
    padding: 3px 0;
  }

  .place {
    color: var(--dim);
    text-align: right;
  }

  .place::before {
    content: "#";
  }

  .podium .place {
    color: var(--accent);
  }

  .event {
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .event:hover {
    color: var(--accent);
  }

  .rating {
    color: var(--dim);
    font-size: 12px;
  }
</style>
