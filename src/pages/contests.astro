---
// `man 7 l3ak-contests` — CTFTime results as a manual page: a tbl(1)-style
// summary, then one section per season.
import Layout from "../layouts/Layout.astro";
import ManPage from "../components/ManPage.astro";
import { META } from "../data/site";
import {
  ALL_RESULTS,
  BEST_RANK,
  FETCHED,
  SEASONS,
  TEAM_URL,
  TOTAL,
  eventUrl,
  tally,
} from "../data/contests";

const COLS = [
  ["first", "1st"],
  ["second", "2nd"],
  ["third", "3rd"],
  ["top10", "top10"],
  ["played", "ctfs"],
] as const;
---

<Layout title={`Contests - ${META.title}`} description="L3ak's CTF results, from CTFTime.">
  <ManPage name="l3ak-contests" section={7} manual="L3ak Team Manual">
    <section>
      <h2>NAME</h2>
      <p>l3ak-contests - how L3ak has placed in CTFs</p>
    </section>

    <section>
      <h2>DESCRIPTION</h2>
      <p>
        {ALL_RESULTS.length} results over {SEASONS.length} seasons, taken from the team's{" "}
        <a href={TEAM_URL}>CTFtime</a> page on {FETCHED}. The best overall rank L3ak has held
        in a season is <b>{BEST_RANK}</b>.
      </p>
      <p>
        Each season lists its events newest first: the place, the event, and the <i>rating</i>{" "}
        points the result earned. Podium finishes are shown in bold.
      </p>
    </section>

    <section>
      <h2>SUMMARY</h2>
      <table class="stats">
        <thead>
          <tr>
            <th scope="col">year</th>
            <th scope="col">rank</th>
            {COLS.map(([, label]) => <th scope="col">{label}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            SEASONS.map((s) => {
              const t = tally(s.results);
              return (
                <tr>
                  <th scope="row">
                    <a href={`#y-${s.year}`}>{s.year}</a>
                  </th>
                  <td>{s.rank ?? "-"}</td>
                  {COLS.map(([key]) => <td>{t[key]}</td>)}
                </tr>
              );
            })
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">total</th>
            <td>{BEST_RANK}</td>
            {COLS.map(([key]) => <td>{TOTAL[key]}</td>)}
          </tr>
        </tfoot>
      </table>
    </section>

    {
      SEASONS.map((s) => (
        <section aria-labelledby={`y-${s.year}`}>
          <h2 id={`y-${s.year}`}>SEASON {s.year}</h2>
          {s.rank && (
            <p>
              Ranked <b>{s.rank}</b> overall with {s.points?.toFixed(3)} points.
            </p>
          )}
          <ol class="results">
            {s.results.map((r) => (
              <li class:list={{ podium: r.place <= 3 }}>
                <span class="place">{r.place}</span>
                <a href={eventUrl(r.eventId)}>{r.name}</a>
                <span class="rating">{r.rating.toFixed(3)}</span>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <section>
      <h2>SEE ALSO</h2>
      <p>
        <a href="/team/">l3ak-team</a>(7), <a href="/writeups/">l3ak-writeups</a>(7)
      </p>
    </section>
  </ManPage>
</Layout>

<style>
  /* Laid out the way tbl(1) would: right-aligned numbers, three cells
     apart, with the header and total in bold. */
  .stats {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .stats th,
  .stats td {
    padding: 0 0 0 3ch;
    text-align: right;
    font-weight: 400;
  }

  .stats :is(th, td):first-child {
    padding-left: 0;
    text-align: left;
  }

  .stats :is(thead, tfoot) :is(th, td) {
    font-weight: 700;
    color: var(--fg);
  }

  .stats tfoot :is(th, td) {
    padding-top: 1lh;
  }

  .results {
    list-style: none;
    padding: 0;
  }

  /* ManPage zeroes the margins under a heading; the season line keeps a
     blank row between it and the list. */
  p + .results {
    margin-top: 1lh;
  }

  /* Place, event, rating: one row per result, columns kept by the grid. */
  .results li {
    display: grid;
    grid-template-columns: 3ch minmax(0, 1fr) max-content;
    column-gap: 2ch;
    max-width: 72ch;
  }

  .place,
  .rating {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .results a {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
  }

  .results a:hover {
    text-decoration: underline;
  }

  .podium :is(.place, a) {
    font-weight: 700;
    color: var(--fg);
  }

  .results li:not(.podium) a {
    color: var(--muted);
  }
</style>
