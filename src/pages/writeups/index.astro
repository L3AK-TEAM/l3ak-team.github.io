---
import { PS1 } from "../../components/shell/PS1";
import Layout from "../../layouts/Layout.astro";
import { META } from "../../data/site";
import { listWriteups } from "../../lib/writeups";

const writeups = await listWriteups();
---

<Layout title={`Writeups - ${META.title}`} description="Writeups by L3ak.">
  <article class="doc">
    <header class="cmd">
      <h1>
        <span class="ps" aria-hidden="true"><PS1 /></span>{" "}cd <span class="cwd">writeups</span>
      </h1>
      <p class="sub">// {writeups.length} writeups</p>
    </header>

    <ul class="doc-list">
      {
        writeups.map((w) => (
          <li>
            <a href={w.url}>{w.title}</a>
            <span class="doc-meta">
              {w.event} / {w.chal} / {w.cat} / {w.date}
            </span>
          </li>
        ))
      }
    </ul>
  </article>
</Layout>
