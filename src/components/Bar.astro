---
const SHORTCUTS = [
  { href: "/", label: "home" },
  { href: "/team/", label: "team" },
  { href: "/writeups/", label: "writeups" },
] as const;

const here = Astro.url.pathname;
// "/" prefixes every path, so home only counts as current on an exact match.
const isCurrent = (href: string) =>
  href === "/" ? here === "/" : here.startsWith(href);
---

<header class="bar">
  <a class="brand" href="/">
    {/* Reserve height via intrinsic size */}
    <img src="/l3ak-logo.png" alt="L3ak" width="423" height="219" />
  </a>
  <nav aria-label="Shortcuts">
    {
      SHORTCUTS.map((s) => (
        <a
          class="cmdbtn"
          href={s.href}
          aria-current={isCurrent(s.href) ? "page" : undefined}
        >
          {s.label}
        </a>
      ))
    }
  </nav>
</header>
